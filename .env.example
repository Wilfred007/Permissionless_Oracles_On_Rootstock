# Network Configuration
RSK_RPC_URL=https://public-node.testnet.rsk.co
NETWORK=rskTestnet

# Contract Addresses (fill after deployment)
CONTRACT_ADDRESS=0x...
CONFIG_CONTRACT_ADDRESS=0x...

# Node Configuration
PRIVATE_KEY=0x...
# Do not commit the actual private key to version control

# Contract ABIs (minified JSON)
CONTRACT_ABI=[{"inputs":...}]
CONFIG_ABI=[{"inputs":...}]

# Optional: Monitoring
DASHBOARD_PORT=3000
LOG_LEVEL=info